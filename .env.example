# DataVeritas local LLM settings
#
# Copy these names into a local .env file or define them as environment variables.
# The real .env is ignored by Git.

LLM_PROVIDER=ollama

# Ollama
OLLAMA_MODEL=gemma4:latest
OLLAMA_BASE_URL=http://localhost:11434

# Gemini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=

# OpenAI
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

# Custom / OpenAI-compatible APIs
# Examples of model ids: openrouter/openai/gpt-5-mini, deepseek/deepseek-chat,
# openai/my-custom-model with CUSTOM_LLM_BASE_URL.
CUSTOM_LLM_MODEL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=

# Optional provider-native env vars used when CUSTOM_LLM_MODEL has these prefixes.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
